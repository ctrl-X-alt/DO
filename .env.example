# OpenRouter API key. Never put this in public/index.html.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Pick any OpenRouter model you want. openrouter/auto is a good experiment default.
OPENROUTER_MODEL=openrouter/auto
PORT=3000
APP_URL=http://localhost:3000


SCREEN_DESIGN="https://www.figma.com/design/u1MySFE2Hbxof95pxEI1mp/Untitled?node-id=0-1&t=L4yfzy8GqqM7IVDy-1"


